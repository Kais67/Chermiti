# Copiez ce fichier en ".env" puis remplacez les valeurs. Ne jamais publier .env.
JWT_SECRET=REMPLACEZ-PAR-UNE-LONGUE-CHAINE-ALEATOIRE
PORT=3000
# ---- Mode multi-écoles / PostgreSQL (production) : voir docs/architecture_multi_ecoles.md ----
# PlatformDB (registre des écoles). Sans cette variable : SQLite local (tests / démonstration uniquement).
# PLATFORM_DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/plateforme
# Compte pouvant créer des bases (CREATE DATABASE) : une base indépendante est créée pour chaque école.
# PG_ADMIN_URL=postgres://utilisateur:motdepasse@hote:5432/postgres
# Chiffre les URL des bases d'écoles dans PlatformDB (à sauvegarder ailleurs ; défaut : JWT_SECRET)
# TENANT_SECRET=
# Premier super-administrateur de la plateforme (créé au démarrage si aucun n'existe)
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
# École choisie quand la requête n'en précise aucune (déploiement mono-école). Détermination : en-tête X-Ecole, sous-domaine (BASE_DOMAIN), ?ecole=
# DEFAULT_ECOLE_SLUG=
# BASE_DOMAIN=ecoles.exemple.tn
# Dossier des fichiers déposés (monter un disque persistant en production) et origines autorisées (CORS) pour l'application Android
# UPLOADS_DIR=
# CORS_ORIGINS=
# Facultatif : emplacement des bases SQLite de démonstration (par défaut server/data/)
# DB_FILE=server/data/school.db
# Mot de passe des comptes de démonstration (seed)
# DEMO_PASSWORD=Demo2026!

# URL publique (pour les liens dans les messages), ex. https://ecole-aboukacem-chebbi.com
# PUBLIC_URL=
# E-mail facultatif : renseignez SMTP_HOST pour activer l'envoi d'e-mails après paiement
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=ecole@exemple.tn

# E-mails via l'API Brevo (fonctionne sur Render gratuit, contrairement au SMTP)
# BREVO_API_KEY=
# MAIL_FROM=ecole@exemple.tn
# MAIL_FROM_NAME=École Abou El Kacem Chebbi

# Relances automatiques d'impayés (désactivées par défaut) : une relance par élève tous les N jours
# RELANCES_AUTO=true
# RELANCES_JOURS=7

# Paiement en ligne : « simulation » (DÉMONSTRATION, aucun argent réel) ou « desactive ». Les fournisseurs réels (Flouci, Konnect) se configurent
# par école dans l'interface (Paiements en ligne) ; voir docs/paiements.md. Variables globales de repli : FLOUCI_PUBLIC_KEY, FLOUCI_PRIVATE_KEY, KONNECT_API_KEY, KONNECT_WALLET_ID.
# Par défaut : actif en développement et en démonstration, DÉSACTIVÉ en production réelle.
# Un vrai paiement exige un compte marchand chez un prestataire (ex. Konnect, Paymee, Flouci, ClicToPay) : non branché dans cette version.
# PAIEMENT_EN_LIGNE=simulation

# ---- DÉMONSTRATION (projet Cloud et Big Data) : crée deux écoles complètes (A et B, 6 profils chacune) ----
# Comptes : voir docs/demo_comptes.md. Pour repartir de zéro : arrêter le serveur puis « npm run reset:demo ».
DEMO_ECOLES=true
ALLOW_DEMO_SEED=true
SUPER_ADMIN_EMAIL=superadmin@demo.tn
# Les guillemets sont OBLIGATOIRES : sans eux, le caractère # démarre un commentaire et le mot de passe est tronqué
SUPER_ADMIN_PASSWORD="SuperDemo#2026"
