# Copiez ce fichier en ".env" puis remplacez les valeurs. Ne jamais publier .env.
JWT_SECRET=REMPLACEZ-PAR-UNE-LONGUE-CHAINE-ALEATOIRE
PORT=3000
# Facultatif : emplacement de la base SQLite (par défaut server/data/school.db)
# DB_FILE=server/data/school.db
# Mot de passe des comptes de démonstration (seed)
# DEMO_PASSWORD=Demo2026!

# URL publique (pour les liens dans les messages), ex. https://ecole-aboukacem-chebbi.com
# PUBLIC_URL=
# E-mail facultatif : renseignez SMTP_HOST pour activer l'envoi d'e-mails après paiement
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=ecole@exemple.tn

# E-mails via l'API Brevo (fonctionne sur Render gratuit, contrairement au SMTP)
# BREVO_API_KEY=
# MAIL_FROM=ecole@exemple.tn
# MAIL_FROM_NAME=École Abou El Kacem Chebbi

# Relances automatiques d'impayés (désactivées par défaut) : une relance par élève tous les N jours
# RELANCES_AUTO=true
# RELANCES_JOURS=7

# Paiement en ligne des parents : « simulation » (démonstration, aucun argent réel) ou « desactive ».
# Par défaut : actif en développement et en démonstration, DÉSACTIVÉ en production réelle.
# Un vrai paiement exige un compte marchand chez un prestataire (ex. Konnect, Paymee, Flouci, ClicToPay) : non branché dans cette version.
# PAIEMENT_EN_LIGNE=simulation
